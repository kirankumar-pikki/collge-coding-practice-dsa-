import java.util.*;

public class Sum {
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int a=0;
		int b=1;
		System.out.println("enter limit");
		int limit=sc.nextInt();
		System.out.println(a);
		System.out.println(b);
		
		for(int i=2;i<limit;i++) {
			int c=a+b;
			System.out.println(c);
			a=b;
			b=c;
		}

	}
